#!/usr/bin/env bash
#MISE description="Download a file from Google Drive"
#USAGE arg "<key>" help="Drive file path, or Drive file ID when --id is set"
#USAGE arg "[dest]" help="Local destination path (default: stdout)"
#USAGE flag "--id" help="Treat key as a Drive file ID (from drive:list JSON output)"

set -euo pipefail

source "$MISE_CONFIG_ROOT/.mise/tasks/drive/_env"

KEY="$usage_key"
DEST="${usage_dest:-}"
BY_ID="${usage_id:-false}"

if [ "$BY_ID" = "true" ]; then
  # rclone backend copyid bypasses root_folder_id scope — it fetches by raw
  # Drive ID, not by path within the configured folder. IDs should come from
  # drive:list output to stay within the intended folder.
  if [ -z "$DEST" ]; then
    tmp=$(mktemp)
    trap 'rm -f "$tmp"' EXIT
    rclone backend copyid "$DRIVE_TARGET" "$KEY" "$tmp"
    cat "$tmp"
  else
    rclone backend copyid "$DRIVE_TARGET" "$KEY" "$DEST"
    echo "Downloaded: ${KEY} -> ${DEST}" >&2
  fi
else
  if [ -z "$DEST" ]; then
    rclone cat "${DRIVE_TARGET}${KEY}"
  else
    rclone copyto -q "${DRIVE_TARGET}${KEY}" "$DEST"
    echo "Downloaded: ${KEY} -> ${DEST}" >&2
  fi
fi
